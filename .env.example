# ─────────────────────────────────────────────────────────────────────────────
# Embassy of Liberia Portal — environment variables
# Copy to .env (local) or set in your hosting provider. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the site (used for Stripe redirects, email links, sitemap)
APP_URL=http://localhost:3000

# PostgreSQL connection string.
# Local (npm run db:local): postgresql://embassy:embassy@localhost:5433/embassy
DATABASE_URL=postgresql://embassy:embassy@localhost:5433/embassy

# Long random secret (>= 32 chars) used to sign local download links.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# ── Stripe (use TEST MODE keys during development: sk_test_..., whsec_...) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── File storage ────────────────────────────────────────────────────────────
# "local" stores files in a PRIVATE directory outside /public (development only).
# "database" stores files privately in PostgreSQL (serverless hosts such as Vercel, small demos).
# "s3" uses a PRIVATE S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
STORAGE_DRIVER=local
# Hard upload cap in MB (max 10). Use 4 on Vercel, whose functions reject bodies over ~4.5 MB.
UPLOAD_MAX_MB=10
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to true for MinIO / some S3-compatible providers
S3_FORCE_PATH_STYLE=false

# ── Email ───────────────────────────────────────────────────────────────────
# "console" logs emails to the server console (development). "smtp" sends them.
EMAIL_TRANSPORT=console
EMAIL_FROM="Embassy Portal (Demo) <no-reply@example.org>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Address that receives new contact-inquiry notifications
INQUIRY_NOTIFY_EMAIL=

# ── Security / operations ───────────────────────────────────────────────────
# Session lifetime in hours (applicants / staff)
SESSION_TTL_HOURS_APPLICANT=72
SESSION_TTL_HOURS_STAFF=8
# Days after a decision before documents of COMPLETED/REJECTED applications are purged
RETENTION_DAYS_DOCUMENTS=180
# Days before abandoned drafts are deleted
RETENTION_DAYS_DRAFTS=90

# Initial super-admin (used by: npm run admin:create)
ADMIN_EMAIL=
ADMIN_PASSWORD=
