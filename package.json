{
  "name": "embassy-of-higeria-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Demonstration digital services portal for the Embassy of the Republic of Higeria, Washington, D.C. (not an officially authorized government website).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:local": "node scripts/local-postgres.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "admin:create": "node scripts/create-admin.mjs",
    "retention:purge": "node scripts/retention-purge.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^1.69.0",
    "next": "^15.5.29",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "stripe": "^17.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "vitest": "^3.2.7"
  }
}
